# Copy to .env for local lab runs (do not commit real secrets).

# Bind address. device mode must stay on 127.0.0.1 (or localhost).
# shared mode can be 0.0.0.0, or 127.0.0.1 when a proxy in front terminates TLS.
AUTH_BIND=127.0.0.1:8080

# device = this computer only. shared = other Command Center installs can connect.
# Unset means shared. Secret storage is refused unless mode is device.
AUTH_MODE=shared
# AUTH_SECRET_STORE=false

# SQLite path (created automatically).
AUTH_DB=./data/auth-server.db

# HS256 secret for lab access JWTs (32+ random bytes, hex or long string).
# Upgrade to Ed25519/RS256 before wider use — see README.
AUTH_JWT_SECRET=change-me-to-a-long-random-lab-secret

# Token lifetimes (seconds).
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=1209600

# Issuer / audience claims.
AUTH_JWT_ISS=command-center-auth
AUTH_JWT_AUD=command-center-desktop

# Self-register from Command Center (default on). Set false to lock signup.
# The server admin can change this from http://127.0.0.1:8080/admin.
# That admin is not a Command Center board login.
AUTH_ALLOW_REGISTER=true

# Simple login rate limit (attempts per window per IP+username).
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_SECS=300
