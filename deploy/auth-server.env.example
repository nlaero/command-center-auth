AUTH_BIND=127.0.0.1:8080
# shared: other devices connect (directly, or through a proxy on this host).
# device + AUTH_SECRET_STORE=true is the this-computer install. Do not set that here
# unless this host really is a single-computer server.
AUTH_MODE=shared
AUTH_DB=/var/lib/auth-server/auth-server.db
AUTH_JWT_SECRET=replace-with-long-random-secret
AUTH_ACCESS_TTL_SECS=900
AUTH_REFRESH_TTL_SECS=1209600
AUTH_JWT_ISS=command-center-auth
AUTH_JWT_AUD=command-center-desktop
# Board self-registration. The server admin can change this from /admin.
# That admin is created by --install and is not a board login.
AUTH_ALLOW_REGISTER=true
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_SECS=300
